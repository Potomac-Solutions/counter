<!--
  Where an order is: placed, being made, ready, picked up. A Sync document only the server writes
  ('use collection orders by order'); the page may read it because it's this guest's own. When the
  kitchen moves it along, the guest's phone follows without a reload.
-->
<script>
  'use collection orders by order'
  import { from } from '@zubra/runtime'

  let status = from(statusNow)

  const steps = ['placed', 'making', 'ready', 'picked-up']
  const labels = { placed: 'Placed', making: 'Being made', ready: 'Ready at the window', 'picked-up': 'Picked up' }
  const reached = steps.indexOf(status)
</script>
<style>
  :host { display: grid; gap: 0.6rem; }
  ol { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  li { padding: 0.35rem 0.8rem; border-radius: 999px; box-shadow: 0 0 0 1px var(--border, #e3d6c6); color: var(--muted-foreground, #7a6a58); font-weight: 600; }
  li.done { background: var(--primary, #6b3f22); color: var(--primary-foreground, #fff); box-shadow: none; }
  .ready { margin: 0; padding: 0.8rem 1rem; border-radius: 0.6rem; background: #f6e1c8; color: #5a2e10; font-weight: 700; }
</style>
<order-progress order="" status-now="placed">
  <p class="ready" zb-if={status === 'ready'} role="status">Your order is ready at the window.</p>
  <ol aria-label="Where your order is">
    <zb-each items={steps} as="step" key={step}>
      <li class:done={steps.indexOf(step) <= reached} aria-current={step === status ? 'step' : null}>{labels[step]}</li>
    </zb-each>
  </ol>
</order-progress>
