<!--
  The kitchen's note about today (the special, what's fresh), live. A Sync document only the
  server writes ('use collection notes by note'): when the kitchen posts a new note, every
  open page shows it without a reload. The server HTML already has it (`text-now`).
-->
<script>
  'use collection notes by note'
  import { from } from '@zubra/runtime'

  let text = from(textNow)
  let at = from(atNow)

  // The server can't format a time, so it sends it already in words (`at-label`); the element
  // formats a new one itself when a note is posted live.
  const when = at === atNow ? atLabel : at ? new Date(at).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone }) : ''
</script>
<style>
  :host { display: block; }
  aside { display: grid; gap: 0.2rem; padding: 1rem 1.25rem; border-radius: var(--radius, 1rem); background: var(--note, #f6e8d6); box-shadow: inset 4px 0 0 var(--rust, #b4532a); }
  p { margin: 0; font-size: 1.08rem; }
  strong { font-family: var(--font-heading, inherit); font-weight: 600; }
  small { color: var(--muted-foreground, #6a5a49); }
</style>
<kitchen-note note="" text-now="" at-now={0} at-label="" time-zone="America/New_York">
  <aside zb-if={text} aria-live="polite">
    <p><strong>From the kitchen today:</strong> {text}</p>
    <small zb-if={when}>Posted at {when}</small>
  </aside>
</kitchen-note>
